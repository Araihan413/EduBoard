# ─── EduBoard Web — Environment Variables Example ─────────────────────────────────────
# Salin file ini menjadi '.env.local' untuk local development.
# Di platform deploy (Vercel), set variabel ini di dashboard Environment Variables.
# JANGAN commit file '.env.local' ke git (sudah di-.gitignore).

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ─── API Backend ──────────────────────────────────────────────────────────────
# URL server API (Fastify). Digunakan oleh REST API client.
# Development: http://localhost:4000
# Production : https://api-anda.railway.app (ganti setelah deploy API)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── WebSocket ────────────────────────────────────────────────────────────────
# URL koneksi Socket.IO. Biasanya sama dengan API URL.
# Development: http://localhost:4000
# Production : https://api-anda.railway.app (ganti setelah deploy API)
NEXT_PUBLIC_WS_URL="http://localhost:4000"
