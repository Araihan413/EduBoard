# ─── EduBoard API — Environment Variables Example ─────────────────────────────────────
# Salin file ini menjadi '.env' dan sesuaikan nilainya.
# JANGAN commit file '.env' ke git (sudah di-.gitignore).

# ─── Database ─────────────────────────────────────────────────────────────────
# Connection string Supabase (via connection pooler - PgBouncer)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connection string langsung (untuk Prisma migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── Supabase Auth ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ─── Keamanan JWT ─────────────────────────────────────────────────────────────
# WAJIB diisi. Generate dengan: openssl rand -base64 32
JWT_SECRET="generate-your-own-random-secret-key-here"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Development: biarkan kosong (default ke http://localhost:3000)
# Production: isi dengan URL frontend produksi (pisahkan dengan koma jika lebih dari satu)
# Contoh: CORS_ORIGIN="https://eduboard-pai.vercel.app"
CORS_ORIGIN=
